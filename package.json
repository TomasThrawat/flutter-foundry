{
	"name": "flutter-foundry",
	"version": "1.0.0",
	"private": false,
	"description": "Open-source Flutter engineering MCP with SVG-Edit + Playwright icon workflow.",
	"license": "MIT",
	"engines": {
		"node": ">=20.9.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "tsx --test tests/*.test.ts",
		"test:svg-edit": "playwright test tests/svg-edit.integration.spec.ts",
		"test:icons": "tsx --test tests/icon-pipeline.test.ts tests/icon-generator.test.ts tests/icon-png.test.ts tests/svg-sanitize.test.ts",
		"test:icons:coverage": "node --experimental-test-coverage --test-coverage-include=lib/icon-*.ts --test-coverage-include=lib/svg-edit.ts --import=tsx --test tests/icon-pipeline.test.ts tests/icon-generator.test.ts tests/icon-png.test.ts tests/svg-sanitize.test.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.4.0",
		"@sparticuz/chromium": "^138.0.2",
		"@xmldom/xmldom": "^0.9.12",
		"mcp-handler": "^2.3.0",
		"next": "^16.4.3",
		"playwright-core": "^1.54.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sharp": "^0.35.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.54.2",
		"@types/node": "^22.0.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.13.0",
		"eslint-config-next": "^16.4.3",
		"tsx": "^4.19.0",
		"typescript": "^5.8.0",
		"@eslint/eslintrc": "^3.3.1"
	},
	"overrides": {
		"postcss": "^8.5.23",
		"postcss-selector-parser@^6.0.0": "^6.1.5",
		"postcss-selector-parser@^7.0.0": "^7.1.7",
		"@eslint/config-array": {
			"minimatch": "^11.0.1"
		},
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.1"
		},
		"eslint": {
			"minimatch": "^11.0.1"
		}
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
