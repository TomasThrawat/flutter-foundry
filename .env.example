# Optional bearer auth for MCP. Recommended for public deployments.
MCP_API_TOKEN=
# Optional bearer auth for the browser-heavy icon API.
ICON_API_TOKEN=
# Official default SVG-Edit deployment.
SVG_EDIT_URL=https://svgedit.netlify.app/index.html
# Optional comma-separated absolute roots for audit MCP. Defaults to current working directory.
AUDIT_ALLOWED_ROOTS=
# Per-engine timeout in milliseconds; capped at 20000.
AUDIT_ENGINE_TIMEOUT_MS=12000
