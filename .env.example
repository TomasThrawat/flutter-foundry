# MCP endpoints intentionally remain unauthenticated; do not send private data to them.
# Optional bearer auth for the browser-heavy icon API.
ICON_API_TOKEN=
# Official default SVG-Edit deployment.
SVG_EDIT_URL=https://svgedit.netlify.app/index.html
# Optional comma-separated absolute roots for local audit MCP. Defaults to current working directory.
AUDIT_ALLOWED_ROOTS=
# Per-engine timeout in milliseconds; capped at 20000.
AUDIT_ENGINE_TIMEOUT_MS=12000
# Fine-grained token for GitHub Actions dispatch: Actions read/write and Contents read on this repo only.
# This credential is used server-side; it does not authenticate MCP requests.
GITHUB_AUDIT_TOKEN=
# Optional distributed request limiting for Vercel; both values are required.
# Without these, a bounded best-effort per-instance limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
